# Use free-plan accounts to stay within their free quotas.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini is used when Groq fails, times out, or has no key.
# Existing GENAI_API_KEY is also accepted for compatibility.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional legacy alias; GEMINI_API_KEY above also works for embeddings.
GENAI_API_KEY=
# Import and verify before using the collection in production.
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_NAMESPACE=default_keyspace
ASTRA_DB_COLLECTION=portfolio_profile_v1
